# Copy to .env; CLI automatically loads it without overriding shell variables.
DATABASE_PATH=data/outreach.sqlite3
CAMPAIGN_ID=tech-ugc-2026
BRAND_NAME=Your Brand
BRAND_DESCRIPTION=an educational technology product for curious learners
CAMPAIGN_OFFER=a paid educational content collaboration
# Real AI generation (OpenAI-compatible chat completions)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional second discovery provider
YOUTUBE_API_KEY=
# Sending is SIMULATED unless --live is supplied. TLS SMTP only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Live SMTP additionally requires LIVE_SEND_ENABLED=yes
LIVE_SEND_ENABLED=no
# Server binds loopback by default; set 0.0.0.0 for a hosted preview.
HOST=127.0.0.1
PORT=8000
# Required for non-loopback binding. Choose a long random value.
DASHBOARD_TOKEN=
